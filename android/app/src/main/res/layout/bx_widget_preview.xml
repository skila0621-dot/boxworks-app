<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르는 화면의 미리보기(목록 대신 고정 네 줄). 실제 위젯은 bx_widget.xml.
     4×2 '오늘 일정' 위젯. 시험판 36(대표 결정 11/3 17:01, 위젯 디자인 · 동작 검토):
     맨 위 한 줄은 가운데 정렬 — 말하기(🎤) · ‹ 날짜 › · 새 일정(＋). 날짜를 누르면 오늘로, ‹ ›로 하루씩(10분 지나면 저절로 오늘).
     목록은 그날 일정만, 위아래로 밀어 끝까지(BxWidgetService). 그릴 때 지금 시각 바로 앞 일정부터 보이게 맞춘다.
     줄은 시각 · 색 막대 · 제목만(하는 중이면 파란 띠와 '지금'). 위젯이 작아서 장소 · 출발 · 확인 필요는 앱에서 본다.
     '루틴 포함 / 일정만'은 위젯 위가 아니라 앱 ⋯ › 위젯 추가 화면의 스위치(자료의 only) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="말하기 · 바로 말로 일정 추가">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bx_widget_round2"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_widget_mic_a" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:contentDescription="전날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>
        <TextView
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="오늘"
            android:textColor="@color/bx_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:contentDescription="다음 날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="새 일정">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bx_widget_round"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <LinearLayout
    
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_dim"
                android:text="08:30"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#C9CED6" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_dim"
                android:text="출근 준비"
                android:textSize="14.5sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
            android:background="@drawable/bx_widget_live"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_accent"
                android:text="10:00"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="@color/bx_w_accent" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="팀 회의"
                android:textSize="14.5sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_accent"
                android:text="지금"
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
    
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="12:30"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#D9468F" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="점심 약속"
                android:textSize="14.5sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="12.5sp" />
        </LinearLayout>

        <LinearLayout
    
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="46dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="15:00"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#2E9E6A" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="치과"
                android:textSize="14.5sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="12.5sp" />
        </LinearLayout>

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
