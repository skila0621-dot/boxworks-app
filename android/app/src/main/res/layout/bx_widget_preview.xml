<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 고르기 목록의 미리 보기(시험판 38 모양): ‹ 날짜 › · 가로줄 · 목록 · 오른쪽 아래 아이콘 단추 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical">

    <!-- 날짜 줄: ‹ 날짜 ›만. 날짜를 누르면 오늘로(오늘이면 앱), ‹ ›로 하루씩 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">
        <FrameLayout
            
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:contentDescription="전날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>
        <TextView
            
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="오늘 · 11월 3일 (화)"
            android:textColor="@color/bx_w_ink"
            android:textSize="16sp"
            android:textStyle="bold" />
        <FrameLayout
            
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:contentDescription="다음 날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
    </LinearLayout>
    <!-- 날짜 줄과 목록 사이 가로줄(나-1) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bx_w_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_dim"
                android:text="오전 8:30"
                android:textSize="14sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#C9CED6" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_dim"
                android:text="출근 준비"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:background="@drawable/bx_widget_live"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_accent"
                android:text="오전 10:00"
                android:textSize="14sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="@color/bx_w_accent" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="팀 회의"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_accent"
                android:text="지금"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
    
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="오후 12:30"
                android:textSize="14sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#D9468F" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="점심 약속"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
    
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="오후 3:00"
                android:textSize="14sp"
                android:textStyle="bold" />
            <FrameLayout
                android:layout_width="3dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:background="#2E9E6A" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/bx_w_ink"
                android:text="치과"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:maxWidth="130dp"
                android:textColor="@color/bx_w_ink2"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>

                </LinearLayout>
        <!-- 일정이 많으면 아래가 흐려지고, 오른쪽 아래에 아이콘만 작게(엄지 닿는 곳): 말하기 · 새 일정 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bx_widget_fade" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginRight="4dp"
                android:contentDescription="메모 · 떠오른 것을 바로 적기">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round2"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_memo" />
            </FrameLayout>
            <FrameLayout
                
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="말하기 · 바로 말로 일정 추가">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round2"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_mic_a" />
            </FrameLayout>
            <FrameLayout
                
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:contentDescription="새 일정">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_plus" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
