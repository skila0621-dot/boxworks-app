<?xml version="1.0" encoding="utf-8"?>
<!-- 2×2 '지금 단계' 위젯(전체 흐름 와이어프레임 10): 지금 단계, 출발까지 남은 시간, 진행, 다음 단계, 확인 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/n_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="지금"
        android:textColor="@color/bx_w_ink2"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/n_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bx_w_ink"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/n_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bx_w_accent"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/n_prog"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="5"
        android:progress="1"
        android:progressDrawable="@drawable/bx_widget_prog" />

    <TextView
        android:id="@+id/n_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/bx_w_ink2"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/n_ok"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bx_widget_btn"
        android:gravity="center"
        android:text="확인"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
