<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 '오늘 일정' 위젯. 시험판 36(대표 결정 11/3 17:01, 위젯 디자인 · 동작 검토):
     맨 위 한 줄은 가운데 정렬 — 말하기(🎤) · ‹ 날짜 › · 새 일정(＋). 날짜를 누르면 오늘로, ‹ ›로 하루씩(10분 지나면 저절로 오늘).
     목록은 그날 일정만, 위아래로 밀어 끝까지(BxWidgetService). 그릴 때 지금 시각 바로 앞 일정부터 보이게 맞춘다.
     줄은 시각 · 색 막대 · 제목만(하는 중이면 파란 띠와 '지금'). 위젯이 작아서 장소 · 출발 · 확인 필요는 앱에서 본다.
     '루틴 포함 / 일정만'은 위젯 위가 아니라 앱 ⋯ › 위젯 추가 화면의 스위치(자료의 only).
     시험판 37(대표 지적 11/3 '위젯에서도 좌우 여백이 좁다'): 바깥 여백 8 → 14dp, 줄 높이 32 → 36dp, 글자는 위젯 끝에서 22dp -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingTop="10dp"
    android:paddingRight="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/w_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="말하기 · 바로 말로 일정 추가">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bx_widget_round2"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_widget_mic_a" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_prev"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:contentDescription="전날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>
        <TextView
            android:id="@+id/w_head"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="오늘"
            android:textColor="@color/bx_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_next"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:contentDescription="다음 날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/w_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="새 일정">
            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="center"
                android:background="@drawable/bx_widget_round"
                android:importantForAccessibility="no"
                android:padding="8dp"
                android:src="@drawable/ic_widget_plus" />
        </FrameLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">
        <!-- 오른쪽 가는 막대가 늘 보여 '더 있음'을 알린다 -->
        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadeScrollbars="false"
            android:listSelector="@android:color/transparent"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/bx_widget_thumb"
            android:scrollbars="vertical" />
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="일정 없음"
            android:textColor="@color/bx_w_ink2"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
