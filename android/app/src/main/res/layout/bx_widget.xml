<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 '오늘 일정' 위젯. 시험판 36(대표 결정 11/3 17:01): 그날 일정만, 위아래로 밀어 끝까지(BxWidgetService), 지금 시각 바로 앞 일정부터.
     줄은 시각 · 색 막대 · 제목만(하는 중이면 파란 띠와 '지금'). '루틴 포함 / 일정만'은 앱 위젯 추가 화면의 스위치(자료의 only).
     시험판 37(대표 지적 11/3 '위젯도 좌우 여백이 좁다'): 목록 여백 14dp, 줄 높이 36dp.
     시험판 38(대표 의견 18:39 '단추가 너무 위, 엄지 닿는 곳으로' → 대표 결정 19:06 '나-1'):
     위에는 ‹ 날짜 ›만, 그 아래 가로줄로 목록과 나눔. 말하기 · 새 일정은 오른쪽 아래 아이콘만 작게, 목록 아래는 흐려짐 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical">

    <!-- 날짜 줄: ‹ 날짜 ›만. 날짜를 누르면 오늘로(오늘이면 앱), ‹ ›로 하루씩 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">
        <FrameLayout
            android:id="@+id/w_prev"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:contentDescription="전날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_prev" />
        </FrameLayout>
        <TextView
            android:id="@+id/w_head"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="오늘"
            android:textColor="@color/bx_w_ink"
            android:textSize="15sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_next"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:contentDescription="다음 날">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_widget_next" />
        </FrameLayout>
    </LinearLayout>
    <!-- 날짜 줄과 목록 사이 가로줄(나-1) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bx_w_line" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="14dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1">
        <!-- 오른쪽 가는 막대가 늘 보여 '더 있음'을 알린다. 아래 단추에 가리지 않게 끝 줄 밑으로 40dp 더 밀 수 있다 -->
        <ListView
            android:id="@+id/w_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:fadeScrollbars="false"
            android:listSelector="@android:color/transparent"
            android:paddingBottom="40dp"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@drawable/bx_widget_thumb"
            android:scrollbars="vertical" />
        <TextView
            android:id="@+id/w_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="일정 없음"
            android:textColor="@color/bx_w_ink2"
            android:textSize="14sp"
            android:visibility="gone" />
        <!-- 일정이 많으면 아래가 흐려지고, 오른쪽 아래에 아이콘만 작게(엄지 닿는 곳): 메모 · 말하기 · 새 일정(시험판 41: ✎ 메모를 맨 왼쪽에) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bx_widget_fade" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/w_memo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginRight="4dp"
                android:contentDescription="메모 · 떠오른 것을 바로 적기">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round2"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_memo" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_mic"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="말하기 · 바로 말로 일정 추가">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round2"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_mic_a" />
            </FrameLayout>
            <FrameLayout
                android:id="@+id/w_add"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginLeft="4dp"
                android:contentDescription="새 일정">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bx_widget_round"
                    android:importantForAccessibility="no"
                    android:padding="10dp"
                    android:src="@drawable/ic_widget_plus" />
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
