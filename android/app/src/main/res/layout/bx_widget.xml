<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 '오늘 일정' 위젯(전체 흐름 와이어프레임 10). 삼성 리마인더 위젯에서 빠져 불만이 많았던 시각·색·지난 일 구분을 지킨다 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bx_widget_bg"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingTop="12dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_head"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="오늘"
            android:textColor="@color/bx_w_ink"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_late"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/bx_widget_late"
            android:gravity="center"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:textColor="@color/bx_w_warn"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/w_mic"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bx_widget_mic_bg"
            android:contentDescription="말로 넣기"
            android:padding="10dp"
            android:src="@drawable/ic_widget_mic" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="다가오는 일정이 없어요 · 말하기 단추로 넣어 보세요"
        android:textColor="@color/bx_w_ink2"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_r1_box"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_r1_t"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_r1_c"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/bx_w_accent" />
        <TextView
            android:id="@+id/w_r1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="14.5sp" />
        <TextView
            android:id="@+id/w_r1_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:textColor="@color/bx_w_ink2"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_r2_box"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_r2_t"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_r2_c"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/bx_w_accent" />
        <TextView
            android:id="@+id/w_r2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="14.5sp" />
        <TextView
            android:id="@+id/w_r2_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:textColor="@color/bx_w_ink2"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_r3_box"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_r3_t"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_r3_c"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/bx_w_accent" />
        <TextView
            android:id="@+id/w_r3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="14.5sp" />
        <TextView
            android:id="@+id/w_r3_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:textColor="@color/bx_w_ink2"
            android:textSize="12.5sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/w_r4_box"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/w_r4_t"
            android:layout_width="46dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="13.5sp"
            android:textStyle="bold" />
        <FrameLayout
            android:id="@+id/w_r4_c"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="@color/bx_w_accent" />
        <TextView
            android:id="@+id/w_r4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/bx_w_ink"
            android:textSize="14.5sp" />
        <TextView
            android:id="@+id/w_r4_r"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:maxLines="1"
            android:maxWidth="110dp"
            android:ellipsize="end"
            android:textColor="@color/bx_w_ink2"
            android:textSize="12.5sp" />
    </LinearLayout>
</LinearLayout>
